
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedProducts } from "../../lib/products";
import { normalizeProductDescription } from "../../utils/product-description";
import OrderModal from "../../components/OrderModal.astro";

const BASE_URL = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const products = await getPublishedProducts();

  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const primaryImage =
  product.product_images.find((image) => image.is_primary) ??
  product.product_images[0];

// Badge
const badgeName = product.badge_name;
const isAvailable = badgeName?.toLocaleUpperCase("vi-VN") === "CÓ SẴN";

const pageTitle = product.meta_title || `${product.name} | Mèo Hoa`;

const pageDescription =
  product.meta_description ||
  product.description ||
  `Khám phá ${product.name} tại Mèo Hoa.`;

// Format price
const formatPrice = (price: number) =>
  new Intl.NumberFormat("vi-VN", {
    maximumFractionDigits: 0,
  }).format(price) + " ₫";

// Chuẩn hóa thông tin mô tả sản phẩm
const details = normalizeProductDescription(product.description);

// Nguồn năng lượng
const powerLabels = details.power.map((power) => {
  if (power.toLocaleLowerCase("vi-VN") === "năng lượng mặt trời") {
    return "Mặt trời";
  }

  return power;
});

// Các thẻ thông tin sản phẩm
const productTags = [
  ...powerLabels,
  details.size,
  details.waving !== null
    ? details.waving
      ? "Vẫy tay"
      : "Không vẫy tay"
    : null,
].filter(Boolean);

// Mô tả và đặc điểm còn lại
const otherDetails = details.features;

// URL website và URL sản phẩm
const siteUrl = Astro.site ?? new URL("https://meohoa.io.vn");
const productUrl = new URL(`/san-pham/${product.slug}/`, siteUrl).toString();

// URL ảnh tuyệt đối
const productImages = product.product_images
  .map((image) => image.image_url)
  .filter(Boolean)
  .map((image) => new URL(image, siteUrl).toString());

const schemaDescription = (
  product.meta_description ||
  product.description ||
  `Khám phá ${product.name} tại Mèo Hoa.`
)
  .replace(/<[^>]*>/g, " ")
  .trim();

// Product Schema
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  url: productUrl,
  ...(productImages.length > 0 && {
    image: productImages,
  }),
  ...(schemaDescription && {
    description: schemaDescription,
  }),
  brand: {
    "@type": "Brand",
    name: "Mèo Hoa",
  },
  offers: {
    "@type": "Offer",
    url: productUrl,
    priceCurrency: "VND",
    price: String(product.price),
    seller: {
      "@type": "Organization",
      name: "Mèo Hoa",
      url: siteUrl.toString(),
    },
    ...(badgeName && {
      availability:
        badgeName.toLocaleUpperCase("vi-VN") === "CÓ SẴN"
          ? "https://schema.org/InStock"
          : badgeName.toLocaleUpperCase("vi-VN") === "THEO YÊU CẦU"
            ? "https://schema.org/PreOrder"
            : undefined,
    }),
  },
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Trang chủ",
      item: new URL("/", siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Sản phẩm",
      item: new URL(`${BASE_URL}san-pham/`, siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: product.name,
      item: productUrl,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/san-pham/${product.slug}/`}
  ogImage={primaryImage?.image_url}
>
  <!-- SEO Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <main
    class="mx-auto w-[calc(100%-32px)] max-w-[1200px] pb-16 sm:pb-20 md:pb-28"
  >
    <!-- Breadcrumb -->
    <nav
      class="flex flex-wrap gap-2 py-6 text-[11px] text-[#8a7b70]"
      aria-label="Breadcrumb"
    >
      <a class="no-underline hover:text-[#794640]" href={BASE_URL}>
        Trang chủ
      </a>

      <span aria-hidden="true">/</span>

      <a
        class="no-underline hover:text-[#794640]"
        href={`${BASE_URL}san-pham/`}
      >
        Sản phẩm
      </a>

      <span aria-hidden="true">/</span>

      <span aria-current="page">{product.name}</span>
    </nav>

    <section
      class="grid items-start gap-8 pt-2 md:grid-cols-[minmax(0,1.1fr)_minmax(0,.9fr)] md:gap-16 lg:gap-20"
    >
      <!-- Product Image Gallery -->
      <div class="min-w-0">
        <!-- Main image -->
        <div
          class="relative overflow-hidden bg-[#f0e9df]"
          data-product-gallery
        >
          <!-- Product badge -->
          {
            badgeName && (
              <span
                class:list={[
                  "absolute left-3 top-3 z-10 inline-flex items-center px-3 py-2 text-[10px] font-semibold tracking-[0.14em] shadow-sm sm:left-5 sm:top-5 sm:px-4 sm:py-2.5 sm:text-[11px]",
                  isAvailable
                    ? "bg-[#794640] text-white"
                    : "bg-[#A66B32] text-white",
                ]}
              >
                {badgeName}
              </span>
            )
          }

          {
            primaryImage ? (
              <button
                type="button"
                data-open-gallery
                aria-label={`Phóng to ảnh sản phẩm ${product.name}`}
                class="group block w-full cursor-zoom-in text-left focus-visible:outline-2 focus-visible:outline-[#794640]"
              >
                <img
                  data-main-image
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02] md:aspect-[4/5]"
                  src={primaryImage.image_url}
                  alt={primaryImage.alt?.trim() || product.name}
                  fetchpriority="high"
                  decoding="async"
                />
              </button>
            ) : (
              <div
                class="grid aspect-[4/3] w-full place-items-center bg-[#f0e9df] font-heading text-3xl text-[#a58a73] md:aspect-[4/5]"
                role="img"
                aria-label={`Hình ảnh minh họa cho ${product.name}`}
              >
                Mèo Hoa
              </div>
            )
          }

          <!-- Click hint -->
          {
            primaryImage && (
              <span class="pointer-events-none absolute bottom-3 right-3 z-10 flex items-center gap-2 bg-black/35 px-3 py-2 text-[10px] tracking-wide text-white backdrop-blur-sm">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <circle cx="10.5" cy="10.5" r="6.5" />
                  <path d="m16 16 5 5M10.5 7.5v6M7.5 10.5h6" />
                </svg>
                PHÓNG TO
              </span>
            )
          }
        </div>

        <!-- Thumbnail list -->
        {
          product.product_images.length > 1 && (
            <div
              class="mt-3 flex gap-2 overflow-x-auto pb-2 sm:gap-3"
              data-thumbnail-list
            >
              {product.product_images.map((image, index) => (
                <button
                  type="button"
                  data-thumbnail
                  data-image-src={image.image_url}
                  data-image-alt={image.alt?.trim() || product.name}
                  aria-label={`Xem ảnh ${index + 1} của ${product.name}`}
                  aria-pressed={image.id === primaryImage?.id}
                  class:list={[
                    "group relative aspect-square w-[68px] shrink-0 overflow-hidden bg-[#f0e9df] transition-all duration-200 sm:w-[76px] lg:w-[84px]",
                    "border",
                    image.id === primaryImage?.id
                      ? "border-[#794640] ring-1 ring-[#794640]"
                      : "border-transparent hover:border-[#b99b85]",
                  ]}
                >
                  <img
                    src={image.image_url}
                    alt={image.alt?.trim() || product.name}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <!-- Product information -->
      <div class="md:sticky md:top-8">
        <p class="text-[11px] font-semibold tracking-[0.18em] text-[#8a6257]">
          MÈO HOA · GIFTS & FLOWERS
        </p>

        <!-- Product name -->
        <h1
          class="mt-5 font-heading text-[clamp(34px,4vw,52px)] font-normal leading-[1.15] text-[#794640]"
        >
          {product.name}
        </h1>

        <!-- Price -->
        <div
          class="mt-5 flex flex-wrap items-baseline gap-3 border-b border-[#e8dfd5] pb-6"
        >
          <span class="text-2xl font-semibold text-[#794640]">
            {formatPrice(product.price)}
          </span>

          {
            product.original_price !== null &&
              product.original_price > product.price && (
                <span class="text-sm text-[#9b8d81] line-through">
                  {formatPrice(product.original_price)}
                </span>
              )
          }
        </div>

        <!-- Product details -->
        <div class="mt-7 space-y-4 text-[15px] leading-7 text-[#74665d]">
          <!-- Product tags -->
          {
            productTags.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                {productTags.map((tag) => (
                  <span
                    class="inline-flex items-center rounded-sm border border-[#e5d8ca] bg-[#f8f5f0] px-2 py-0 md:px-3 md:py-1.5 text-[11px] md:text-[13px] font-medium text-[#794640]"
                  >
                    {tag}
                  </span>
                ))}
              </div>
            )
          }

          <!-- Remaining description -->
          {
            otherDetails.length > 0 && (
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[15px] leading-7 text-[#74665d]">
                {otherDetails.map((detail, index) => (
                  <>
                    {index > 0 && <span class="text-[#c4b5a5]">·</span>}
                    <span>{detail}</span>
                  </>
                ))}
              </div>
            )
          }
        </div>

        <!-- Order button: desktop and tablet -->
        <button
          type="button"
          data-open-order-modal
          aria-haspopup="dialog"
          class="mt-8 hidden items-center justify-center gap-3 bg-[#794640] px-6 py-4 text-[12px] font-semibold tracking-wide text-white transition-colors hover:bg-[#603731] sm:inline-flex sm:w-auto"
        >
          Liên hệ đặt hàng
        </button>
      </div>
    </section>
  </main>

  <!-- Fullscreen Product Image Lightbox -->
  <div
    data-image-lightbox
    class="fixed inset-0 z-[100] flex items-center justify-center bg-[#171412]/95 px-3 py-5 opacity-0 transition-opacity duration-200 sm:px-8"
    role="dialog"
    aria-modal="true"
    aria-label="Thư viện ảnh sản phẩm"
    hidden
  >
    <!-- Close button -->
    <button
      type="button"
      data-lightbox-close
      aria-label="Đóng thư viện ảnh"
      class="absolute right-4 top-4 z-30 flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:bg-white/15 sm:right-8 sm:top-7"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="m18 6-12 12M6 6l12 12" />
      </svg>
    </button>

    <!-- Image counter -->
    <div
      data-lightbox-counter
      class="absolute left-1/2 top-7 z-20 -translate-x-1/2 text-[12px] tracking-[0.2em] text-white/75"
    >
      1 / 1
    </div>

    <!-- Previous button -->
    <button
      type="button"
      data-lightbox-prev
      aria-label="Ảnh trước"
      class="absolute left-2 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:bg-white/15 sm:left-8 sm:h-14 sm:w-14"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>

    <!-- Lightbox image stage -->
    <div
      class="flex h-full w-full items-center justify-center overflow-hidden"
      data-lightbox-stage
    >
      <img
        data-lightbox-image
        src=""
        alt={product.name}
        draggable="false"
        class="max-h-[calc(100dvh-100px)] max-w-[calc(100vw-32px)] select-none object-contain opacity-0 transition-opacity duration-200 sm:max-h-[calc(100dvh-120px)] sm:max-w-[calc(100vw-160px)]"
      />
    </div>

    <!-- Next button -->
    <button
      type="button"
      data-lightbox-next
      aria-label="Ảnh tiếp theo"
      class="absolute right-2 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:bg-white/15 sm:right-8 sm:h-14 sm:w-14"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>

    <!-- Bottom hint -->
    <p
      class="pointer-events-none absolute bottom-5 left-1/2 -translate-x-1/2 whitespace-nowrap text-[10px] tracking-[0.12em] text-white/45"
    >
      VUỐT ĐỂ XEM ẢNH TIẾP THEO
    </p>
  </div>

  <!-- Mobile fixed order button -->
  <div
    class="fixed inset-x-0 bottom-0 z-40 border-t border-[#e8dfd5] bg-[#fffdfa]/95 px-4 pb-[calc(12px+env(safe-area-inset-bottom))] pt-3 backdrop-blur-md sm:hidden"
  >
    <button
      type="button"
      data-open-order-modal
      aria-haspopup="dialog"
      class="flex w-full items-center justify-center gap-3 bg-[#794640] px-6 py-4 text-[12px] font-semibold tracking-wide text-white shadow-sm transition-colors hover:bg-[#603731]"
    >
      Liên hệ đặt hàng
    </button>
  </div>

  <!-- Order Modal -->
  <OrderModal
    product={product}
    imageUrl={primaryImage?.image_url}
    powerLabels={powerLabels}
    waving={details.waving}
  />

  <!-- Lightbox Styles -->
  <style>
    [data-image-lightbox][hidden] {
      display: none !important;
    }

    [data-image-lightbox].is-open {
      opacity: 1;
    }

    [data-image-lightbox] button:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 3px;
    }

    [data-lightbox-image].is-loaded {
      opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      [data-image-lightbox],
      [data-lightbox-image] {
        transition: none;
      }
    }
  </style>

  <!-- Gallery & Lightbox Script -->
  <script>
    const galleries = document.querySelectorAll<HTMLElement>(
      "[data-product-gallery]",
    );

    galleries.forEach((gallery) => {
      const mainImage =
        gallery.querySelector<HTMLImageElement>("[data-main-image]");

      const openButton =
        gallery.querySelector<HTMLButtonElement>("[data-open-gallery]");

      const container = gallery.parentElement;

      const thumbnails =
        container?.querySelectorAll<HTMLButtonElement>("[data-thumbnail]");

      const modal = document.querySelector<HTMLElement>(
        "[data-image-lightbox]",
      );

      const modalImage = modal?.querySelector<HTMLImageElement>(
        "[data-lightbox-image]",
      );

      const counter = modal?.querySelector<HTMLElement>(
        "[data-lightbox-counter]",
      );

      const closeButton = modal?.querySelector<HTMLButtonElement>(
        "[data-lightbox-close]",
      );

      const prevButton = modal?.querySelector<HTMLButtonElement>(
        "[data-lightbox-prev]",
      );

      const nextButton = modal?.querySelector<HTMLButtonElement>(
        "[data-lightbox-next]",
      );

      const stage = modal?.querySelector<HTMLElement>(
        "[data-lightbox-stage]",
      );

      if (!mainImage || !modal || !modalImage || !openButton) return;

      type GalleryImage = {
        src: string;
        alt: string;
      };

      const images: GalleryImage[] = thumbnails?.length
        ? Array.from(thumbnails).map((thumbnail) => ({
            src: thumbnail.dataset.imageSrc || "",
            alt: thumbnail.dataset.imageAlt || "",
          }))
        : [
            {
              src: mainImage.src,
              alt: mainImage.alt,
            },
          ];

      const normalizeUrl = (src: string) =>
        new URL(src, window.location.href).href;

      let currentIndex = Math.max(
        0,
        images.findIndex(
          (image) => normalizeUrl(image.src) === mainImage.src,
        ),
      );

      let previousOverflow = "";
      let previousFocus: HTMLElement | null = null;

      let touchStartX = 0;
      let touchStartY = 0;

      const updateCounter = () => {
        if (counter) {
          counter.textContent = `${currentIndex + 1} / ${images.length}`;
        }
      };

      // Đồng bộ trạng thái thumbnail
      const updateThumbnails = () => {
        thumbnails?.forEach((thumbnail, index) => {
          const isActive = index === currentIndex;

          thumbnail.setAttribute("aria-pressed", String(isActive));

          thumbnail.classList.toggle("border-[#794640]", isActive);
          thumbnail.classList.toggle("ring-1", isActive);
          thumbnail.classList.toggle("ring-[#794640]", isActive);
          thumbnail.classList.toggle("border-transparent", !isActive);
        });
      };

      // Hiển thị ảnh theo index
      const showImage = (index: number) => {
        if (!images.length) return;

        currentIndex = (index + images.length) % images.length;

        const image = images[currentIndex];

        modalImage.classList.remove("is-loaded");

        modalImage.src = image.src;
        modalImage.alt = image.alt;

        mainImage.src = image.src;
        mainImage.alt = image.alt;

        updateCounter();
        updateThumbnails();
      };

      modalImage.addEventListener("load", () => {
        modalImage.classList.add("is-loaded");
      });

      modalImage.addEventListener("error", () => {
        modalImage.classList.remove("is-loaded");
      });

      // Mở modal
      const openLightbox = () => {
        if (!images.length) return;

        previousFocus =
          document.activeElement instanceof HTMLElement
            ? document.activeElement
            : null;

        currentIndex = Math.max(
          0,
          images.findIndex(
            (image) => normalizeUrl(image.src) === mainImage.src,
          ),
        );

        showImage(currentIndex);

        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";

        modal.hidden = false;

        requestAnimationFrame(() => {
          modal.classList.add("is-open");
          closeButton?.focus();
        });
      };

      // Đóng modal
      const closeLightbox = () => {
        if (modal.hidden) return;

        modal.classList.remove("is-open");

        document.body.style.overflow = previousOverflow;

        modal.hidden = true;

        previousFocus?.focus();
      };

      // Chuyển ảnh
      const nextImage = () => {
        showImage(currentIndex + 1);
      };

      const prevImage = () => {
        showImage(currentIndex - 1);
      };

      // Mở ảnh
      openButton.addEventListener("click", openLightbox);

      // Đóng ảnh
      closeButton?.addEventListener("click", closeLightbox);

      // Điều hướng
      nextButton?.addEventListener("click", nextImage);
      prevButton?.addEventListener("click", prevImage);

      // Click nền tối để đóng
      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          closeLightbox();
        }
      });

      // Bàn phím
      document.addEventListener("keydown", (event) => {
        if (modal.hidden) return;

        switch (event.key) {
          case "Escape":
            closeLightbox();
            break;

          case "ArrowRight":
            event.preventDefault();
            nextImage();
            break;

          case "ArrowLeft":
            event.preventDefault();
            prevImage();
            break;
        }
      });

      // Vuốt trái / phải trên điện thoại
      stage?.addEventListener(
        "touchstart",
        (event) => {
          const touch = event.changedTouches[0];

          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
        },
        { passive: true },
      );

      stage?.addEventListener(
        "touchend",
        (event) => {
          const touch = event.changedTouches[0];

          const deltaX = touch.clientX - touchStartX;
          const deltaY = touch.clientY - touchStartY;

          // Chỉ nhận diện thao tác vuốt ngang
          if (
            Math.abs(deltaX) < 45 ||
            Math.abs(deltaX) < Math.abs(deltaY)
          ) {
            return;
          }

          if (deltaX < 0) {
            nextImage();
          } else {
            prevImage();
          }
        },
        { passive: true },
      );

      // Click thumbnail để đổi ảnh
      thumbnails?.forEach((thumbnail, index) => {
        thumbnail.addEventListener("click", () => {
          showImage(index);
        });
      });
    });
  </script>
</BaseLayout>
