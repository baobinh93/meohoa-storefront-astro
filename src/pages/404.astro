---
import BaseLayout from "../layouts/BaseLayout.astro";
const BASE_URL = import.meta.env.BASE_URL;

const homeUrl = BASE_URL;
const productsUrl = `${BASE_URL}san-pham/`;
const contactUrl = `${BASE_URL}#lien-he`;

// Thay bằng đường dẫn ảnh mèo thần tài bạn muốn sử dụng
const errorImage = `${BASE_URL}/images/404/404.webp`;
---

<BaseLayout
  title="Không tìm thấy trang | Mèo Hoa"
  description="Trang bạn tìm kiếm không tồn tại tại Mèo Hoa."
>
  <main
    class="relative flex min-h-screen flex-col overflow-hidden px-5 py-8 sm:px-10 sm:py-10"
  >
    <!-- Background decoration -->
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_35%,rgba(246,222,184,0.42),transparent_48%),radial-gradient(ellipse_at_95%_55%,rgba(245,220,222,0.32),transparent_38%),radial-gradient(ellipse_at_5%_90%,rgba(249,225,190,0.32),transparent_35%)]"
    >
    </div>

    <!-- Header -->
    <header class="relative z-10 flex items-center justify-between">
      <a
        href={homeUrl}
        class="inline-flex items-center gap-2 bg-white/40 px-4 py-3 text-[11px] font-semibold tracking-[0.12em] text-[#80643b] transition hover:bg-white/80"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M19 12H5M12 19l-7-7 7-7"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        QUAY LẠI TRANG CHỦ
      </a>

      <span
        class="flex items-center gap-2 text-[10px] font-semibold tracking-[0.12em] text-[#66534e] sm:text-xs"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#92703d]"></span>
        MÃ LỖI 404
      </span>
    </header>

    <!-- Main content -->
    <section
      class="relative z-10 mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center pb-20 pt-12 text-center"
    >
      <!-- Product image -->
      <div class="relative mb-8 w-full max-w-[290px] sm:max-w-[330px]">
        <div
          class="rounded-[10px] bg-white p-3 shadow-[0_18px_50px_rgba(89,62,42,0.10)]"
        >
          <div
            class="aspect-[4/4.2] overflow-hidden rounded-[5px] bg-[#f3e9dc]"
          >
            <img
              src={errorImage}
              alt="Mèo thần tài Mèo Hoa"
              class="h-full w-full object-cover"
            />
          </div>
        </div>

        <!-- Gold decoration -->
        <div
          class="absolute -right-3 -top-3 flex h-9 w-9 items-center justify-center rounded-full bg-[#ffdda0] text-[#725127] shadow-sm"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M12 3l2.2 3.2 3.8-.2-.2 3.8L21 12l-3.2 2.2.2 3.8-3.8-.2L12 21l-2.2-3.2-3.8.2.2-3.8L3 12l3.2-2.2L6 6l3.8.2L12 3Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"></path>
            <circle cx="12" cy="12" r="2.5" stroke="currentColor"></circle>
          </svg>
        </div>

        <!-- Product label -->
        <div
          class="absolute -bottom-3 left-1/2 flex -translate-x-1/2 items-center gap-2 whitespace-nowrap bg-white px-5 py-2 text-[11px] font-semibold tracking-[0.12em] text-[#80643b] shadow-sm"
        >
          <span>♧</span>
          LẠC LỐI MAY MẮN
        </div>
      </div>

      <!-- Brand -->
      <div
        class="mb-3 flex items-center gap-3 text-[12px] font-semibold tracking-[0.18em] text-[#92703d]"
      >
        <span class="h-px w-6 bg-[#92703d]"></span>
        MÈO HOA
        <span class="h-px w-6 bg-[#92703d]"></span>
      </div>

      <h1
        class="font-heading text-4xl font-medium tracking-tight text-[#642e36] sm:text-5xl md:text-[54px]"
      >
        404 Page Not Found
      </h1>

      <p class="mt-4 text-lg italic text-[#947344] sm:text-xl">
        Trang quý khách đang tìm kiếm hiện đang trong quá trình cập nhật...
      </p>

      <!-- Actions -->
      <div
        class="mt-14 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row sm:gap-5"
      >
        <a
          href={homeUrl}
          class="flex min-h-12 w-full items-center justify-center gap-2 bg-[#79434a] px-7 text-xs font-semibold tracking-wide text-white shadow-[0_8px_20px_rgba(89,48,55,0.18)] transition hover:bg-[#603139] sm:w-auto"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1V10Z"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linejoin="round"></path>
          </svg>
          VỀ TRANG CHỦ
        </a>

        <a
          href={productsUrl}
          class="flex min-h-12 w-full items-center justify-center gap-2 bg-white/65 px-7 text-xs font-semibold tracking-wide text-[#423833] transition hover:bg-white sm:w-auto"
        >
          <span class="text-lg text-[#92703d]">✧</span>
          KHÁM PHÁ BỘ SƯU TẬP MÈO HOA
        </a>

        <a
          href={contactUrl}
          class="flex min-h-12 w-full items-center justify-center gap-2 px-5 text-xs font-semibold tracking-wide text-[#66534e] transition hover:text-[#79434a] sm:w-auto"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 5h16v12H8l-4 4V5Z"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linejoin="round"></path>
          </svg>
          TƯ VẤN QUA LIÊN HỆ
        </a>
      </div>
    </section>

    <!-- Floating contact -->
    <div class="fixed bottom-6 right-5 z-20 flex flex-col items-end gap-2">
      <span
        class="bg-white px-3 py-2 text-[10px] font-semibold tracking-wider text-[#80643b] shadow-[0_5px_20px_rgba(0,0,0,0.06)]"
      >
        TƯ VẤN TRỰC TIẾP
      </span>

      <a
        href={contactUrl}
        aria-label="Liên hệ Mèo Hoa"
        class="flex h-12 w-12 items-center justify-center rounded-xl bg-white text-[#79434a] shadow-[0_5px_20px_rgba(0,0,0,0.08)] transition hover:-translate-y-1"
      >
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
          <path
            d="M4 5h16v12H8l-4 4V5Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </main>
</BaseLayout>
