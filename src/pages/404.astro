---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Không tìm thấy trang | Mèo Hoa"
  description="Trang bạn tìm kiếm không tồn tại tại Mèo Hoa."
>
  <main
    class="mx-auto flex min-h-[55vh] w-[calc(100%-32px)] max-w-[760px] flex-col items-center justify-center py-20 text-center"
  >
    <p class="text-[10px] font-semibold tracking-[0.2em] text-[#8a6257]">
      MÈO HOA
    </p>
    <h1 class="mt-5 font-serif text-5xl font-normal text-[#794640]">404</h1>
    <p class="mt-3 text-sm leading-7 text-[#74665d]">
      Trang này không còn ở đây hoặc đường dẫn chưa chính xác.
    </p>
    <a
      class="mt-6 bg-[#794640] px-5 py-3 text-xs text-white no-underline hover:bg-[#603731]"
      href="/">Quay về trang chủ</a
    >
  </main>
</BaseLayout>
