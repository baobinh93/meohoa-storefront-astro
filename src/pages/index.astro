---
import BaseLayout from "../layouts/BaseLayout.astro";
const BASE_URL = import.meta.env.BASE_URL;
const pageTitle = "Mèo Hoa | Hoa lụa và quà tặng tinh tế";
const pageDescription =
  "Khám phá hoa lụa, mèo thần tài và giỏ quà tinh tế tại Mèo Hoa.";
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/">
  <main>
    <!-- SECTION 01: HERO | Mobile + Desktop -->

    <section
      class="overflow-hidden bg-background-cream py-12 sm:py-16 lg:py-20"
    >
      <!-- MOBILE HERO: hiển thị dưới breakpoint lg -->
      <div
        class="mx-auto w-[calc(100%-32px)] max-w-105 sm:w-[calc(100%-48px)] lg:hidden"
      >
        <!-- Collection label -->
        <div
          class="mb-2 inline-flex items-center gap-2 rounded-lg bg-badge-yellow/50 px-3 py-1"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5.81875 11.6667C4.90486 11.55 4.08819 11.3167 3.36875 10.9667C2.64931 10.6167 2.03924 10.1597 1.53854 9.59583C1.03785 9.03195 0.65625 8.37813 0.39375 7.63438C0.13125 6.89062 0 6.06667 0 5.1625C1.06944 5.26944 1.97361 5.46389 2.7125 5.74583C3.45139 6.02778 4.05174 6.42639 4.51354 6.94167C4.97535 7.45694 5.30833 8.10104 5.5125 8.87396C5.71667 9.64688 5.81875 10.5778 5.81875 11.6667V11.6667M5.81875 6.75208C5.59514 6.41181 5.29132 6.07639 4.90729 5.74583C4.52326 5.41528 4.07847 5.11389 3.57292 4.84167C3.63125 4.43333 3.72847 4.01042 3.86458 3.57292C4.00069 3.13542 4.16597 2.70521 4.36042 2.28229C4.55486 1.85938 4.77604 1.45347 5.02396 1.06458C5.27187 0.675694 5.53681 0.320833 5.81875 0C6.10069 0.320833 6.36562 0.675694 6.61354 1.06458C6.86146 1.45347 7.08264 1.85938 7.27708 2.28229C7.47153 2.70521 7.63681 3.13542 7.77292 3.57292C7.90903 4.01042 8.00625 4.43333 8.06458 4.84167C7.55903 5.10417 7.11424 5.40069 6.73021 5.73125C6.34618 6.06181 6.04236 6.40208 5.81875 6.75208V6.75208M6.98542 11.4333C6.96597 10.7528 6.91493 10.1233 6.83229 9.54479C6.74965 8.96632 6.62083 8.41944 6.44583 7.90417C6.90278 7.11667 7.53229 6.475 8.33438 5.97917C9.13646 5.48333 10.2375 5.21111 11.6375 5.1625C11.6472 6.69861 11.2365 8.02326 10.4052 9.13646C9.57396 10.2497 8.43403 11.0153 6.98542 11.4333V11.4333"
              fill="#775F34"></path>
          </svg>

          <span
            class="text-[11px] font-semibold uppercase tracking-[0.12em] text-text-accent"
          >
            MÈO HOA COLLECTION
          </span>
        </div>

        <!-- Heading -->
        <h1
          class="m-0 font-heading text-[28px] font-medium leading-[35px]
          tracking-[-0.045em] text-text-heading"
        >
          Quà tặng ý nghĩa,
          <span class="mt-1 block font-heading font-medium">
            trọn vẹn lời chúc.
          </span>
        </h1>

        <!-- Description -->
        <p class="mb-0 mt-2 text-[15px] leading-[24.4px] text-text-navbar">
          Sự kết hợp giữa Mèo thần tài và hoa lụa cao cấp, chăm chút từng chi
          tiết tạo nên món quà ý nghĩa cho những dịp đặc biệt.
        </p>

        <!-- Featured product card -->
        <div
          class="mt-5 overflow-hidden rounded-2xl bg-background-gray-light shadow-[0_4px_6px_-1px_rgb(0_0_0_/_10%)]"
        >
          <!-- Image area -->
          <div class="relative aspect-[0.82/1] overflow-hidden bg-[#E9E0D5]">
            <img
              src={`${import.meta.env.BASE_URL}/images/home/01-hero/hero-01.png`}
              alt="Hộp hoa kết hợp mèo thần tài Mèo Hoa"
              class="absolute inset-0 h-full w-full object-cover"
            />

            <!-- Image label -->
            <span
              class="absolute left-4 top-4 rounded-xl bg-background-cream/90 pt-2.5 px-2.5 pb-1.5
              text-[11px]
              font-semibold uppercase tracking-wide text-text-heading shadow-sm"
            >
              Hoa lụa cao cấp
            </span>

            <!-- Gradient overlay -->
            <div
              class="absolute inset-x-0 bottom-0 h-36 bg-linear-to-t from-black/65 to-transparent"
            >
            </div>

            <!-- Product name and price -->
            <div
              class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-4 sm:p-5"
            >
              <div class="min-w-0">
                <h2
                  class="m-0 font-heading text-[18px] leading-tight text-white font-medium"
                >
                  Mèo Hoa Phú Quý
                </h2>
                <p
                  class="mb-0 mt-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-[#e4e2de]/80 sm:text-xs"
                >
                  SIGNATURE 2026
                </p>
              </div>

              <p
                class="m-0 shrink-0 font-heading text-[23px] font-semibold text-[#ffdea9] sm:text-[27px]"
              >
                1.690.000
              </p>
            </div>
          </div>

          <!-- CTA buttons -->
          <div class="flex flex-col gap-3 p-4 sm:p-5 bg-white">
            <a
              href={`${import.meta.env.BASE_URL}/san-pham/`}
              class="inline-flex min-h-15 items-center justify-center gap-3 rounded-lg
               bg-badge-background px-4 py-4 text-center text-[14px] font-medium
                text-white transition-colors hover:bg-brand-primary"
            >
              Khám phá Mèo Hoa
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                class="h-6 w-6 shrink-0"
              >
                <path
                  d="M4 12h15M13 5l7 7-7 7"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>

            <a
              href="#bo-suu-tap"
              class="inline-flex min-h-15 items-center justify-center rounded-lg
               bg-background-gray-light hover:bg-background-gray
                px-4 py-4 text-center text-[14px] font-medium text-text-black transition-colors hover:bg-border"
            >
              Xem hai bộ sưu tập đặc trưng
            </a>
          </div>
        </div>
      </div>
      <!-- Destop HERO -->
      <div
        class="mx-auto hidden w-[calc(100%-32px)] max-w-360 items-center gap-10
         sm:w-[calc(100%-48px)] lg:grid lg:grid-cols-[0.82fr_1.18fr]
                lg:gap-10 xl:gap-12"
      >
        <!-- LEFT: Hero content -->
        <div class="flex min-w-0 flex-col">
          <!-- Eyebrow -->
          <div class="mb-6 flex items-center gap-3">
            <span class="h-px w-8 shrink-0 bg-brand-gold"></span>
            <p
              class="m-0 text-[14px] font-semibold uppercase tracking-[0.2em]
               text-text-accent"
            >
              MÈO HOA COLLECTION
            </p>
          </div>

          <!-- Heading -->
          <h1
            class="m-0 font-heading text-[56px] font-medium leading-[1.08] tracking-[-0.045em] text-text-heading"
          >
            Quà tặng ý nghĩa,
            <span
              class="mt-1 block font-heading font-normal italic text-text-accent"
            >
              trọn vẹn lời chúc.
            </span>
          </h1>

          <!-- Description -->
          <p
            class="mb-0 mt-6 max-w-140 text-[17px] leading-7 text-text-secondary"
          >
            Sự kết hợp giữa Mèo thần tài và hoa lụa cao cấp, chăm chút từng chi
            tiết tạo nên món quà ý nghĩa cho những dịp đặc biệt.
          </p>

          <!-- CTA buttons -->
          <div class="mt-7 flex flex-col gap-3 min-[420px]:flex-row sm:mt-8">
            <a
              href={`${import.meta.env.BASE_URL}/san-pham/`}
              class="inline-flex min-h-14 items-center justify-center bg-badge-background
              px-6 py-4 text-center text-[11px] font-semibold uppercase tracking-wide
               text-white transition-colors duration-300 hover:bg-brand-primary
               focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-text-heading sm:min-w-[236px]"
            >
              KHÁM PHÁ MÈO HOA
            </a>

            <a
              href={`${import.meta.env.BASE_URL}/san-pham/`}
              class="inline-flex min-h-14 items-center justify-center bg-surface px-6 py-4
              text-center text-xs font-semibold uppercase tracking-wide text-text-primary
               transition-colors duration-300 hover:bg-border focus-visible:outline-2
               focus-visible:outline-offset-4 focus-visible:outline-text-heading
               sm:min-w-[196px] hover:bg-background-gray"
            >
              XEM BỘ SƯU TẬP
            </a>
          </div>

          <!-- Brand benefits -->
          <div
            class="mt-10 grid grid-cols-1 gap-4 rounded-xl bg-surface p-4 min-[420px]:grid-cols-3 min-[420px]:gap-3 sm:mt-14 sm:p-5"
          >
            <!-- Benefit 1 -->
            <div class="flex items-center gap-3">
              <svg
                aria-hidden="true"
                viewBox="0 0 32 32"
                fill="none"
                class="h-6 w-6 shrink-0 text-text-accent"
              >
                <path
                  d="M16 2.5 18.5 9l6.5 2.5-6.5 2.5-2.5 6.5-2.5-6.5L7 11.5 13.5 9 16 2.5Z"
                  fill="currentColor"></path>
                <path
                  d="m6 18 1.5 3.5L11 23l-3.5 1.5L6 28l-1.5-3.5L1 23l3.5-1.5L6 18Z"
                  fill="currentColor"></path>
                <path
                  d="m25 17 1.5 3.5L30 22l-3.5 1.5L25 27l-1.5-3.5L20 22l3.5-1.5L25 17Z"
                  fill="currentColor"></path>
              </svg>
              <p
                class="m-0 text-[11px] font-medium uppercase leading-[1.6] tracking-wide
                 text-text-accent"
              >
                TƯ VẤN TẬN TÂM
              </p>
            </div>

            <!-- Benefit 2 -->
            <div
              class="flex items-center gap-3 min-[420px]:border-l min-[420px]:border-text-accent min-[420px]:pl-3"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 32 32"
                fill="none"
                class="h-6 w-6 shrink-0 text-text-accent"
              >
                <path
                  d="M16 28C8 23 5 17 7 11c5 0 8 4 9 9 1-7 4-11 9-12 2 8-1 15-9 20Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"></path>
                <path
                  d="M16 28V16M12 17l4 4m4-8-4 4"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"></path>
              </svg>
              <p
                class="m-0 text-[11px] font-medium uppercase leading-[1.6] tracking-wide text-text-accent"
              >
                THIẾT KẾ THỦ CÔNG
              </p>
            </div>

            <!-- Benefit 3 -->
            <div
              class="flex items-center gap-3 min-[420px]:border-l min-[420px]:border-text-accent min-[420px]:pl-3"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 32 32"
                fill="none"
                class="h-6 w-6 shrink-0 text-text-accent"
              >
                <rect
                  x="5"
                  y="5"
                  width="22"
                  height="23"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="1.8"></rect>
                <path
                  d="M5 11h22M11 17h10M11 21h10"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"></path>
              </svg>
              <p
                class="m-0 text-[11px] font-medium uppercase leading-[1.6] tracking-wide text-text-accent"
              >
                GIAO HÀNG CHỈN CHU
              </p>
            </div>
          </div>
        </div>

        <!-- RIGHT: Image placeholder -->
        <div class="relative min-w-0">
          <!-- Decorative circles -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -right-5 -top-5 hidden aspect-square w-36 rounded-full border border-gold/30 sm:block lg:-right-7 lg:-top-7 lg:w-44"
          >
          </div>

          <div
            aria-hidden="true"
            class="pointer-events-none absolute -right-8 -top-8 hidden aspect-square
            w-36 rounded-full border border-dashed border-gold/40 sm:block
            lg:-right-10 lg:-top-10 lg:w-44"
          >
          </div>

          <div
            class="relative aspect-4/3 w-full overflow-hidden rounded-lg bg-surface shadow-xl shadow-text-black/10 sm:aspect-[5/4] lg:aspect-[1.08/1]"
          >
            <img
              src={`${import.meta.env.BASE_URL}/images/home/01-hero/hero-01.png`}
              alt="Hộp hoa kết hợp mèo thần tài Mèo Hoa"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>

          <!-- Signature label -->
          <div
            class="absolute bottom-4 left-4 flex max-w-[calc(100%-32px)] items-center gap-3 bg-white
             rounded-md bg-surface px-4 py-3 shadow-lg sm:bottom-6 sm:left-6 sm:gap-4 sm:px-6 sm:py-4 lg:bottom-8 lg:left-8"
          >
            <span class="h-3 w-3 shrink-0 rounded-full bg-[#F5D7A0]"></span>
            <div class="min-w-0">
              <p
                class="m-0 text-[10px] font-medium uppercase tracking-[0.16em] text-text-accent sm:text-[10px]"
              >
                SIGNATURE EDITION
              </p>
              <p
                class="m-0 mt-1 truncate font-heading text-[18px] text-text-heading"
              >
                Phú Quý Cát Tường
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 02: FEATURED COLLECTIONS -->

    <section id="bo-suu-tap" class="bg-background-ivory py-8 sm:py-16">
      <div class="mx-auto w-[calc(100%-32px)] max-w-360 sm:w-[calc(100%-48px)]">
        <!-- Section heading -->
        <div
          class="mb-8 flex flex-col gap-1 sm:mb-14 lg:flex-row lg:items-end lg:justify-between"
        >
          <div>
            <p
              class="mb-1 sm:mb-2 text-[11px] font-semibold uppercase tracking-[0.18em]
               text-text-accent"
            >
              ĐẶC TRƯNG MÈO HOA
            </p>

            <h2
              class="font-heading text-[28px] sm:text-[40px] sm:font-normal font-medium
               leading-tight tracking-[-0.035em] text-text-heading"
            >
              Hai Bộ Sưu Tập Đặc Trưng
            </h2>
          </div>

          <p
            class="m-0 max-w-120
            text-[13px] leading-5
             sm:text-[15px] sm:leading-6
             text-text-secondary"
          >
            Sự kết hợp tinh tế giữa nghệ thuật cắm hoa và mèo thần tài, gửi trao
            lời chúc may mắn, tài lộc và thịnh vượng.
          </p>
        </div>

        <!-- Collection cards -->
        <div
          class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-[1.2fr_0.85fr] lg:gap-8"
        >
          <!-- Card 1: Mèo Hoa -->
          <article
            class="group flex min-w-0 flex-col overflow-hidden rounded-lg
             bg-background-cream shadow-sm transition-shadow duration-300 hover:shadow-lg"
          >
            <!-- Image placeholder -->
            <div
              class="relative aspect-4/3 w-full overflow-hidden bg-[#E9E0D5]
              sm:aspect-[1.55/1] lg:aspect-[1.55/1]"
            >
              <img
                src={`${import.meta.env.BASE_URL}/images/home/02-collections/meohoa-01.png`}
                alt="Bộ sưu tập Mèo Hoa"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                loading="lazy"
              />

              <span
                class="absolute right-3 top-3 w-fit whitespace-nowrap rounded-xl bg-badge-background px-3 py-1
  text-[11px] font-semibold uppercase tracking-wide text-white sm:left-5 sm:right-auto sm:top-5"
              >
                BỘ SƯU TẬP CHỦ ĐẠO
              </span>
            </div>

            <!-- Card content -->
            <div class="flex flex-1 flex-col p-5 sm:p-7 lg:p-8">
              <div class="flex flex-wrap items-center gap-2">
                <div class="">
                  <svg
                    width="16"
                    height="17"
                    viewBox="0 0 16 17"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M7.70175 16.6667C6.91009 16.6667 6.2087 16.4167 5.59759 15.9167C4.98648 15.4167 4.60453 14.7778 4.45175 14C3.71564 14.2361 2.97259 14.2222 2.22259 13.9583C1.47259 13.6944 0.896199 13.2361 0.493421 12.5833C0.0767544 11.9167 -0.0760234 11.1771 0.0350877 10.3646C0.146199 9.55208 0.50731 8.875 1.11842 8.33333C0.535088 7.80556 0.184393 7.15278 0.0663377 6.375C-0.0517178 5.59722 0.0767544 4.875 0.451754 4.20833C0.826754 3.54167 1.39273 3.05903 2.14967 2.76042C2.90662 2.46181 3.66009 2.43056 4.41009 2.66667C4.56287 1.88889 4.94481 1.25 5.55592 0.75C6.16703 0.25 6.86842 0 7.66009 0C8.45175 0 9.15314 0.25 9.76425 0.75C10.3754 1.25 10.7573 1.88889 10.9101 2.66667C11.6879 2.43056 12.4413 2.45139 13.1705 2.72917C13.8997 3.00694 14.4656 3.5 14.8684 4.20833C15.2434 4.90278 15.3788 5.62847 15.2747 6.38542C15.1705 7.14236 14.8129 7.79167 14.2018 8.33333C14.8129 8.875 15.1774 9.54514 15.2955 10.3438C15.4136 11.1424 15.2851 11.8889 14.9101 12.5833C14.5073 13.2917 13.9413 13.7639 13.2122 14C12.483 14.2361 11.7295 14.2361 10.9518 14C10.799 14.7778 10.417 15.4167 9.80592 15.9167C9.19481 16.4167 8.49342 16.6667 7.70175 16.6667V16.6667M7.66009 11.6667C8.57675 11.6667 9.36148 11.3403 10.0143 10.6875C10.667 10.0347 10.9934 9.25 10.9934 8.33333C10.9934 7.41667 10.667 6.63194 10.0143 5.97917C9.36148 5.32639 8.57675 5 7.66009 5C6.74342 5 5.9587 5.32639 5.30592 5.97917C4.65314 6.63194 4.32675 7.41667 4.32675 8.33333C4.32675 9.25 4.65314 10.0347 5.30592 10.6875C5.9587 11.3403 6.74342 11.6667 7.66009 11.6667V11.6667"
                      fill="#5C2730"></path>
                  </svg>
                </div>
                <h3
                  class="m-0 font-heading text-[22px] font-medium text-text-primary"
                >
                  Mèo Hoa
                </h3>
              </div>

              <p class="mb-0 mt-1.5 text-[15px] leading-6 text-text-secondary">
                Những thiết kế quà tặng kết hợp vẻ đẹp tinh tế của hoa lụa cao
                cấp cùng biểu tượng may mắn, gửi trao lời chúc tài lộc, thịnh
                vượng trong những dịp trọng đại.
              </p>

              <a
                href={`${import.meta.env.BASE_URL}/san-pham/`}
                class="mt-2.5 inline-flex w-fit items-center gap-2 py-2 text-[14px]
                font-semibold uppercase tracking-widest text-text-heading
                transition-colors hover:text-text-section focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-text-heading sm:mt-7 sm:text-xs"
              >
                Khám phá bộ sưu tập
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                >
                  <path
                    d="M4 12h15M13 5l7 7-7 7"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </a>
            </div>
          </article>

          <!-- Card 2: Mèo Thần Tài -->
          <article
            class="group flex min-w-0 flex-col overflow-hidden rounded-lg
             bg-background-cream shadow-sm transition-shadow duration-300 hover:shadow-lg"
          >
            <!-- Image placeholder -->
            <div
              class="relative aspect-4/3 w-full overflow-hidden bg-background-ivory
              sm:aspect-[1.55/1] lg:aspect-[1.55/1]"
            >
              <img
                src={`${import.meta.env.BASE_URL}/images/home/02-collections/meothantai-01.png`}
                alt="Bộ sưu tập Mèo Hoa"
                class="absolute inset-0 h-full w-full object-contain transition-transform duration-700 group-hover:scale-[1.03]"
                loading="lazy"
              />

              <span
                class="absolute right-3 top-3 w-fit whitespace-nowrap rounded-xl bg-brand-gold px-3 py-1
  text-[11px] font-semibold uppercase tracking-wide text-white sm:left-5 sm:right-auto sm:top-5"
              >
                SẢN PHẨM CAO CẤP
              </span>
            </div>

            <!-- Card content -->
            <div class="flex flex-1 flex-col p-5 sm:p-7 lg:p-8">
              <div class="flex flex-wrap items-center gap-2">
                <div class="">
                  <svg
                    width="17"
                    height="16"
                    viewBox="0 0 297 297"
                    fill="currentColor"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    class="shrink-0 text-brand-primary"
                  >
