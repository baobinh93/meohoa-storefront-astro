---
import type { Product } from "../types/product";
import { normalizeProductDescription } from "../utils/product-description";
const BASE_URL = import.meta.env.BASE_URL;
interface Props {
  product: Product;
}

const { product } = Astro.props;

const primaryImage =
  product.product_images.find((image) => image.is_primary) ??
  product.product_images[0];

// Badge: chỉ hiển thị khi sản phẩm có trạng thái trong database
const badgeName = product.badge_name;
const isAvailable = badgeName?.toLocaleUpperCase("vi-VN") === "CÓ SẴN";

const formatPrice = (price: number) =>
  new Intl.NumberFormat("vi-VN", {
    maximumFractionDigits: 0,
  }).format(price) + "₫";

const productUrl = `/san-pham/${product.slug}/`;

// Chuẩn hóa thông tin mô tả sản phẩm
const details = normalizeProductDescription(product.description);

// Dòng 1: Nguồn năng lượng
const powerLabels = details.power.map((power) => {
  const normalized = power.toLocaleLowerCase("vi-VN");

  if (normalized === "năng lượng mặt trời") return "Mặt trời";

  return power;
});

// Dòng 3: Kích thước và các đặc điểm khác
const otherDetails = [
  details.size !== null ? `Size ${details.size}cm` : null,
  ...details.features,
].filter(Boolean);
---

<article
  class="product-card group flex h-full min-w-0 flex-col overflow-hidden rounded-lg bg-white
    shadow-[0_3px_10px_rgba(0,0,0,0.09)]
    transition-shadow duration-300
    hover:shadow-[0_6px_18px_rgba(0,0,0,0.12)]"
  data-product-card
  data-name={product.name}
  data-slug={product.slug}
  data-description={product.description ?? ""}
  data-category={product.category_id}
  data-color={product.color_id}
  data-badge={product.badge_name}
  data-price={product.price}
  data-order={product.sort_order}
>
  <!-- Product image -->
  <a
    class="relative p-2 block aspect-4/5 shrink-0 overflow-hidden bg-[#EFEEEA]"
    href={`${import.meta.env.BASE_URL}${productUrl}`}
    aria-label={`Xem sản phẩm ${product.name}`}
  >
    {
      primaryImage ? (
        <img
          class="h-full w-full rounded-xs object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
          src={primaryImage.image_url}
          alt={primaryImage.alt?.trim() || product.name}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div
          class="grid h-full w-full place-items-center bg-[#f8f5f0] font-serif text-2xl tracking-[0.12em] text-[#a58a73]"
          role="img"
          aria-label={`Hình ảnh minh họa cho ${product.name}`}
        >
          Mèo Hoa
        </div>
      )
    }

    <!-- Product badge -->
    {
      badgeName && (
        <span
          class:list={[
            "absolute left-4 top-4 inline-flex items-center rounded-xs px-2.5 py-1 text-[11px] font-semibold",
            isAvailable ? "bg-[#794640] text-white" : "bg-[#A66B32] text-white",
          ]}
        >
          {badgeName}
        </span>
      )
    }

    <!-- Subtle image overlay -->
    <span
      class="pointer-events-none absolute inset-0 border border-black/[0.025]"
      aria-hidden="true"></span>
  </a>

  <!-- Product information -->
  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <!-- Category -->
    {
      product.category_name && (
        <p class="mb-1 text-[13px] font-normal leading-4 text-text-section">
          {product.category_name}
        </p>
      )
    }

    <!-- Product name -->
    <h3
      class="mb-1 line-clamp-2 text-[20px] font-medium font-heading leading-7.5 text-text-heading sm:text-[22px]"
    >
      <a
        class="no-underline transition-colors duration-200 hover:text-[#794640]"
        href={`${import.meta.env.BASE_URL}${productUrl}`}
      >
        {product.name}
      </a>
    </h3>

    <!-- Product details: 3 fixed lines -->
    <div
      class="mt-1 min-h-[3.75rem] space-y-1 text-[13px] font-normal leading-5 text-[#524344]"
    >
      <!-- Line 1: Power sources + Waving -->
      <div class="flex items-center gap-1.5 overflow-hidden whitespace-nowrap">
        {
          powerLabels.length > 0
            ? powerLabels.map((power) => (
                <span class="inline-flex shrink-0 items-center rounded-xs bg-[#EFEEEA] px-2 py-0.5 text-[11px] leading-4">
                  {power}
                </span>
              ))
            : null
        }

        {
          details.waving !== null ? (
            <span class="inline-flex shrink-0 items-center rounded-xs bg-[#EFEEEA] px-2 py-0.5 text-[11px] leading-4">
              {details.waving ? "Lắc tay" : "Không Lắc tay"}
            </span>
          ) : null
        }

        {
          powerLabels.length === 0 && details.waving === null && (
            <span class="invisible" aria-hidden="true">
              Thông tin sản phẩm
            </span>
          )
        }
      </div>

      <!-- Line 2: Reserved -->
      <div class="invisible" aria-hidden="true">Thông tin bổ sung</div>

      <!-- Line 3: Size and other features -->
      <div class="overflow-hidden text-ellipsis whitespace-nowrap">
        {
          otherDetails.length > 0 ? (
            otherDetails.join(" · ")
          ) : (
            <span class="invisible" aria-hidden="true">
              Chi tiết sản phẩm
            </span>
          )
        }
      </div>
    </div>

    <!-- Price and detail button stay at the bottom -->
    <div class="mt-auto pt-4">
      <div class="flex min-h-7 flex-wrap items-baseline gap-x-2 gap-y-1">
        <span class="text-[20px] font-semibold text-[#794640]">
          {formatPrice(product.price)}
        </span>

        {
          product.original_price !== null &&
            product.original_price > product.price && (
              <span class="text-[11px] text-[#a3978a] line-through sm:text-xs">
                {formatPrice(product.original_price)}
              </span>
            )
        }
      </div>

      <!-- Detail button -->
      <a
        href={`${import.meta.env.BASE_URL}${productUrl}`}
        class="mt-3 inline-flex min-h-10 w-full items-center justify-center gap-2 rounded-xs bg-[#EFEEEA] px-3 text-[14px] font-medium tracking-[0.04em] text-text-black no-underline transition-all duration-300 hover:bg-[#794640] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#794640]"
        aria-label={`Xem chi tiết ${product.name}`}
      >
        Xem chi tiết
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        >
          <svg
            class="h-3 w-3 shrink-0 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3.98" x2="20.01" y1="20" y2="4.03"></line>
              <line x1="20.51" x2="20.5" y1="3.61" y2="13.45"></line>
              <line x1="20.42" x2="10.57" y1="3.54" y2="3.5"></line>
            </g>
          </svg>
        </span>
      </a>
    </div>
  </div>
</article>
