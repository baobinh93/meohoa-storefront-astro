---
const BASE_URL = import.meta.env.BASE_URL;
const navigation = [
  { label: "Trang chủ", href: BASE_URL },
  { label: "Sản phẩm", href: `${BASE_URL}/san-pham/` },
  {
    label: "Mèo Hoa",
    href: `${BASE_URL}/san-pham/?category=8af55872-69be-4363-a43f-4fbbdf3a2fe6&badge=co-san`,
  },
  {
    label: "Mèo Thần Tài",
    href: `${BASE_URL}/san-pham/?category=f99923c3-8e77-4158-bac5-0aa243364452&badge=co-san`,
  },
];

const currentYear = new Date().getFullYear();
---

<footer id="lien-he" class="lg:bg-background bg-[#EAE8E4] text-text-navbar">
  <div
    class="mx-auto w-[calc(100%-32px)] max-w-360 py-12 sm:w-[calc(100%-48px)] sm:py-16 lg:py-20"
  >
    <!-- ========================================= -->
    <!-- DESKTOP FOOTER -->
    <!-- ========================================= -->
    <div
      class="hidden grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-x-8 lg:grid lg:grid-cols-[1.35fr_0.8fr_1.2fr_1.1fr] lg:gap-10 xl:gap-14"
    >
      <!-- Brand -->
      <div class="min-w-0">
        <a
          href="/"
          class="inline-block font-heading text-3xl font-medium leading-tight text-text-heading transition-colors hover:text-text-section sm:text-[36px]"
        >
          Mèo Hoa
        </a>

        <p class="mb-0 mt-5 text-sm leading-7 text-text-navbar">
          Chú Mèo Thần Tài với dáng vẻ đáng yêu và bàn tay vẫy chào tượng trưng
          cho lời chúc may mắn, tài lộc và bình an. Mèo Hoa gửi gắm những điều
          tốt lành ấy vào từng giỏ hoa nhỏ xinh, để mỗi món quà trao đi đều mang
          theo yêu thương.
        </p>

        <!-- Social links -->
        <div class="mt-7">
          <p
            class="mb-4 text-xs font-semibold uppercase tracking-[0.12em] text-text-section"
          >
            KẾT NỐI VỚI CHÚNG TÔI:
          </p>

          <div class="flex items-center gap-3">
            <!-- TikTok -->
            <a
              href="https://www.tiktok.com/@meohoagiftboutique"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok Mèo Hoa"
              class="flex h-12 w-12 items-center justify-center rounded-2xl bg-surface text-text-section transition-colors hover:bg-border"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-5 w-5"
              >
                <path
                  d="M19.6 7.2a5.1 5.1 0 0 1-4.1-2.1v9.1a6.2 6.2 0 1 1-6.2-6.2c.4 0 .8 0 1.2.1v3.3a2.9 2.9 0 1 0 1.7 2.6V2h3.4a5.1 5.1 0 0 0 4 4.1v1.1Z"
                ></path>
              </svg>
            </a>

            <!-- Facebook -->
            <a
              href="https://www.facebook.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook Mèo Hoa"
              class="flex h-12 w-12 items-center justify-center rounded-2xl bg-surface text-text-section transition-colors hover:bg-border"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-5 w-5"
              >
                <path
                  d="M13.5 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.3V13h2.8v8h3.4Z"
                ></path>
              </svg>
            </a>

            <!-- Zalo -->
            <a
              href="https://zalo.me/0355051303"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Zalo Mèo Hoa"
              class="flex h-12 w-12 items-center justify-center rounded-2xl bg-surface text-text-section transition-colors hover:bg-border"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 48 48"
                fill="none"
                class="h-5 w-5"
              >
                <g
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
