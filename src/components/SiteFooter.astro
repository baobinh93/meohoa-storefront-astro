---
const BASE_URL = import.meta.env.BASE_URL;
const navigation = [
  { label: "Trang chủ", href: BASE_URL },
  { label: "Sản phẩm", href: `${BASE_URL}/san-pham/` },
  {
    label: "Mèo Hoa",
    href: `${BASE_URL}/san-pham/?category=8af55872-69be-4363-a43f-4fbbdf3a2fe6&badge=co-san`,
  },
  {
    label: "Mèo Thần Tài",
    href: `${BASE_URL}/san-pham/?category=f99923c3-8e77-4158-bac5-0aa243364452&badge=co-san`,
  },
];

const currentYear = new Date().getFullYear();
---

<footer id="lien-he" class="lg:bg-background bg-[#EAE8E4] text-text-navbar">
  <div
    class="mx-auto w-[calc(100%-32px)] max-w-360 py-12 sm:w-[calc(100%-48px)] sm:py-16 lg:py-20"
  >
    <!-- ========================================= -->
    <!-- DESKTOP FOOTER -->
    <!-- ========================================= -->
    <div
      class="hidden grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-x-8 lg:grid lg:grid-cols-[1.35fr_0.8fr_1.2fr_1.1fr] lg:gap-10 xl:gap-14"
    >
      <!-- Brand -->
      <div class="min-w-0">
        <a
          href="/"
          class="inline-block font-heading text-3xl font-medium leading-tight text-text-heading transition-colors hover:text-text-section sm:text-[36px]"
        >
          Mèo Hoa
        </a>

        <p class="mb-0 mt-5 text-sm leading-7 text-text-navbar">
          Mèo Hoa là sự giao hòa giữa nghệ thuật hoa và nét đẹp văn hóa Á Đông
          qua hình tượng Mèo Thần Tài (Maneki-neko). Mỗi tác phẩm được chăm chút
          tỉ mỉ, gửi trao lời chúc tài lộc, may mắn, bình an và thịnh vượng đến
          những người thân yêu.
        </p>

        <!-- Social links -->
        <div class="mt-7">
          <p
            class="mb-4 text-xs font-semibold uppercase tracking-[0.12em] text-text-section"
          >
            KẾT NỐI VỚI CHÚNG TÔI:
          </p>

          <div class="flex items-center gap-3">
            <!-- Website -->
            <a
              href="/"
              aria-label="Website Mèo Hoa"
              class="flex h-12 w-12 items-center justify-center rounded-2xl bg-surface text-text-section transition-colors hover:bg-border"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                class="h-5 w-5"
              >
                <circle
                  cx="12"
                  cy="12"
                  r="9"
                  stroke="currentColor"
                  stroke-width="1.7"></circle>
                <path
                  d="M3.5 9h17M3.5 15h17M12 3c2.3 2.4 3.4 5.4 3.4 9s-1.1 6.6-3.4 9c-2.3-2.4-3.4-5.4-3.4-9S9.7 5 12 3Z"
                  stroke="currentColor"
                  stroke-width="1.5"></path>
              </svg>
            </a>

            <!-- Facebook Messenger -->
            <a
              href="https://www.facebook.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook Mèo Hoa"
              class="flex h-12 w-12 items-center justify-center rounded-2xl bg-surface text-text-section transition-colors hover:bg-border"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                class="h-5 w-5"
              >
                <path
                  d="M4 5h16v12H9l-5 3V5Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"></path>
                <path
                  d="M8 9h8M8 12.5h5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"></path>
              </svg>
            </a>

            <!-- Email -->
            <a
              href="mailto:hello@meohoa.io.vn"
              aria-label="Email Mèo Hoa"
              class="flex h-12 w-12 items-center justify-center rounded-2xl bg-surface text-text-section transition-colors hover:bg-border"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                class="h-5 w-5"
              >
                <rect
                  x="3"
                  y="5"
                  width="18"
                  height="14"
                  rx="1.5"
                  stroke="currentColor"
                  stroke-width="1.7"></rect>
                <path
                  d="m4 7 8 6 8-6"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Collections -->
      <div>
        <h2
          class="mb-5 mt-1 text-xs font-semibold uppercase tracking-[0.12em] text-text-section sm:text-sm"
        >
          BỘ SƯU TẬP
        </h2>

        <ul class="m-0 list-none space-y-3 p-0 text-sm leading-6">
          <li>
            <a
              href=`${BASE_URL}/san-pham/`
              class="transition-colors hover:text-text-heading"
            >
              Mèo Hoa Signature
            </a>
          </li>
          <li>
            <a
              href=`${BASE_URL}/san-pham/`
              class="transition-colors hover:text-text-heading"
            >
              Mèo Thần Tài
            </a>
          </li>
          <li>
            <a
              href=`${BASE_URL}/san-pham/`
              class="transition-colors hover:text-text-heading"
            >
              Hoa Khai Trương
            </a>
          </li>
          <li>
            <a
              href=`${BASE_URL}/san-pham/`
              class="transition-colors hover:text-text-heading"
            >
              Quà Tặng Tân Gia
            </a>
          </li>
          <li>
            <a
              href=`${BASE_URL}/san-pham/`
              class="transition-colors hover:text-text-heading"
            >
              Thiết kế theo Yêu Cầu
            </a>
          </li>
        </ul>
      </div>

      <!-- Process & ordering -->
      <div>
        <h2
          class="mb-5 mt-1 text-xs font-semibold uppercase tracking-[0.12em] text-text-section sm:text-sm"
        >
          QUY TRÌNH &amp; ĐẶT HÀNG
        </h2>

        <ul class="m-0 list-none space-y-4 p-0 text-sm leading-7">
          <li class="flex items-start gap-3">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              class="mt-1 h-5 w-5 shrink-0 text-text-section"
            >
              <circle
                cx="12"
                cy="12"
                r="9"
                stroke="currentColor"
                stroke-width="1.8"></circle>
              <path
                d="M12 7v5l3.5 2"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </svg>

            <span>
              Nhận đặt trước từ 24h - 48h để đảm bảo độ tươi mới và hoàn thiện
              thủ công.
            </span>
          </li>

          <li class="flex items-start gap-3">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              class="mt-1 h-5 w-5 shrink-0 text-text-section"
            >
              <path
                d="M3 7h12v11H3zM15 11h4l3 3v4h-7z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path>
              <circle cx="7" cy="19" r="1.8" fill="currentColor"></circle>
              <circle cx="18" cy="19" r="1.8" fill="currentColor"></circle>
            </svg>

            <span>
              Giao hoa hỏa tốc nội thành với đóng gói bảo vệ chuyên dụng độc
              quyền.
            </span>
          </li>

          <li class="flex items-start gap-3">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              class="mt-1 h-5 w-5 shrink-0 text-text-section"
            >
              <path
                d="m12 2 3 2 4-.2.8 3.8 3.2 2.4-1.5 3.7 1 3.8-3.6 1.8-1.3 3.7-4-.5-3.3 2.2-3-2.7-4 .1-.9-3.8-3.2-2.5 1.5-3.7-1-3.8 3.6-1.8L8.6 3l4 .5L12 2Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
              <path
                d="m8.5 12 2.3 2.3 4.8-5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>

            <span> Cam kết sản phẩm hoạt động ổn định khi giao hàng </span>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h2
          class="mb-5 mt-1 text-xs font-semibold uppercase tracking-[0.12em] text-text-section sm:text-sm"
        >
          LIÊN HỆ
        </h2>

        <div class="space-y-3 text-sm leading-6">
          <p class="m-0">
            LK1-09, KDC Long Châu, Nguyễn Bảo Đức, Tam Hiệp, Đồng Nai
          </p>

          <p class="m-0">
            Hotline / Zalo:
            <a
              href="tel:0908888668"
              class="whitespace-nowrap transition-colors hover:text-text-heading"
            >
              035 505 1303
            </a>
          </p>

          <p class="m-0">Giờ đón tiếp: 08:30 - 20:30 (Thứ 2 - Chủ Nhật)</p>
        </div>

        <a
          href="https://zalo.me/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-text-heading transition-colors hover:text-text-section"
        >
          TƯ VẤN TRỰC TIẾP

          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            class="h-4 w-4"
          >
            <path
              d="M4 12h15M13 5l7 7-7 7"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
    <!-- ========================================= -->
    <!-- DESKTOP BOTTOM BAR -->
    <!-- ========================================= -->
    <div
      class="mt-12 hidden border-t border-border pt-6 sm:mt-16 sm:pt-8 lg:mt-24 lg:block"
    >
      <div
        class="flex flex-col gap-5 text-sm leading-6 text-text-navbar lg:flex-row lg:items-center lg:justify-between"
      >
        <p class="m-0">
          © {currentYear} Mèo Hoa. Bản quyền thuộc về TNBB DEV C.O
        </p>

        <nav aria-label="Chính sách" class="flex flex-wrap gap-x-6 gap-y-3">
          <a
            href=`${BASE_URL}/chinh-sach-bao-hanh/`
            class="transition-colors hover:text-text-heading"
          >
            Chính sách bảo hành
          </a>

          <a
            href=`${BASE_URL}/chinh-sach-van-chuyen/`
            class="transition-colors hover:text-text-heading"
          >
            Chính sách vận chuyển
          </a>

          <a
            href=`${BASE_URL}/bao-mat-thong-tin/`
            class="transition-colors hover:text-text-heading"
          >
            Bảo mật thông tin
          </a>
        </nav>
      </div>
    </div>
    <!-- ========================================= -->
    <!-- MOBILE FOOTER -->
    <!-- ========================================= -->
    <div class="lg:hidden">
      <!-- Brand -->
      <div>
        <a
          href="/"
          class="inline-block font-heading text-[22px] font-medium leading-tight text-text-heading no-underline"
        >
          Mèo Hoa
        </a>

        <p
          class="mb-0 mt-1 text-[11px] font-semibold uppercase leading-6 tracking-[0.12em] text-text-section"
        >
          ART FLORAL &amp; MANEKI-NEKO BOUTIQUE
        </p>

        <p
          class="mb-0 mt-1 text-[13px] leading-[1.8] text-text-navbar sm:text-lg"
        >
          Thương hiệu quà tặng Mèo Thần Tài tại Biên Hòa
        </p>
      </div>

      <!-- Address, opening hours and contact -->
      <div
        class="mt-5 space-y-2 text-[13px] leading-[1.6] text-text-navbar sm:text-lg"
      >
        <!-- Address -->
        <div class="flex items-start gap-4">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            class="h-5 w-5 shrink-0 text-text-heading"
          >
            <path
              d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"></path>
            <circle
              cx="12"
              cy="10"
              r="2.5"
              stroke="currentColor"
              stroke-width="1.8"></circle>
          </svg>

          <p class="m-0">
            LK1-09, KDC Long Châu, Nguyễn Bảo Đức, Tam Hiệp, Đồng Nai
          </p>
        </div>

        <!-- Opening hours -->
        <div class="flex items-start gap-4">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            class="h-5 w-5 shrink-0 text-text-heading"
          >
            <circle
              cx="12"
              cy="12"
              r="9"
              stroke="currentColor"
              stroke-width="1.8"></circle>
            <path
              d="M12 7v5l3.5 2"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>

          <p class="m-0">Mở cửa: 08:00 – 21:30 hằng ngày</p>
        </div>

        <!-- Phone and email -->
        <div class="flex items-start gap-4">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            class="h-5 w-5 shrink-0 text-text-heading"
          >
            <path
              d="M5 3h4l2 5-2.5 2a15 15 0 0 0 5.5 5.5l2-2.5 5 2v4c0 1-1 2-2 2C10 21 3 14 3 5c0-1 1-2 2-2Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"></path>
          </svg>

          <p class="m-0 min-w-0 wrap-break-word">
            <a
              href="tel:0908888668"
              class="no-underline hover:text-text-heading"
            >
              035 505 1303
            </a>
          </p>
        </div>
      </div>

      <!-- Collections and policies -->
      <div
        class="mt-8 grid grid-cols-2 gap-x-5 border-t border-border pt-5 sm:gap-x-8"
      >
        <!-- Collections -->
        <div class="min-w-0">
          <h2
            class="mb-1.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-text-heading sm:text-sm"
          >
            BỘ SƯU TẬP
          </h2>

          <ul
            class="m-0 list-none font-medium space-y-1.5 p-0 text-sm leading-6 text-text-navbar sm:text-base"
          >
            <li>
              <a
                href="/san-pham/"
                class="no-underline transition-colors hover:text-text-heading"
              >
                Mèo Hoa Khai Trương
              </a>
            </li>
            <li>
              <a
                href="/san-pham/"
                class="no-underline transition-colors hover:text-text-heading"
              >
                Mèo Thần Tài Tân Gia
              </a>
            </li>
            <li>
              <a
                href="/san-pham/"
                class="no-underline transition-colors hover:text-text-heading"
              >
                Hộp Quà Cao Cấp
              </a>
            </li>
          </ul>
        </div>

        <!-- Policies -->
        <div class="min-w-0">
          <h2
            class="mb-1.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-text-heading sm:text-sm"
          >
            CHÍNH SÁCH
          </h2>

          <ul
            class="m-0 list-none font-medium space-y-1.5 p-0 text-sm leading-6 text-text-navbar sm:text-base"
          >
            <li>
              <a
                href="/chinh-sach-van-chuyen/"
                class="no-underline transition-colors hover:text-text-heading"
              >
                Giao Hàng 2 Giờ
              </a>
            </li>
            <li>
              <a
                href="/chinh-sach-bao-hanh/"
                class="no-underline transition-colors hover:text-text-heading"
              >
                Bảo Mật &amp; Đổi Trả
              </a>
            </li>
            <li>
              <a
                href="/san-pham/"
                class="no-underline transition-colors hover:text-text-heading"
              >
                Dịch Vụ Doanh Nghiệp
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Mobile copyright -->
      <div class="mt-8 border-t border-border pt-7 text-center">
        <p
          class="m-0 text-[11px] uppercase leading-6 tracking-[0.04em] text-text-navbar/80 sm:text-sm"
        >
          © {currentYear} MÈO HOA. ALL RIGHTS RESERVED.
        </p>
      </div>
    </div>
  </div>
</footer>
